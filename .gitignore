# Dependencies
node_modules/
npm-debug.log*

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.PowerFolder/

# Logs
logs
*.log

# ffmpeg two-pass encoding artifacts (see scripts/convert_to_mp4.py)
ffmpeg2pass*
*.mbtree

# Python virtualenv -- .venv self-ignores via its own .gitignore, but only
# when created by the venv module; be explicit so 'git add .' is always safe.
.venv/
venv/
ENV/

# GitHub Pages build output (produced by .github/workflows/deploy.yml)
_site/

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/

# Grunt intermediate storage
.grunt

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Temporary folders
tmp/
temp/

# Build outputs
dist/
build/

# Backup files
*.bak
*.backup

# Local development
.cache/
.parcel-cache/

# Optional: Ignore specific files you don't want to commit
# documents/CV_YourName.pdf (uncomment if you don't want to commit your CV)
